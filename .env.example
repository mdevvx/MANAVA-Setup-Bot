# Copy to .env and fill in real values. .env is gitignored; this file is NOT —
# never put real secrets here.

# --- Discord ---
DISCORD_BOT_TOKEN=your-bot-token-here
DISCORD_GUILD_ID=123456789012345678

# --- Database ---
# Supabase SESSION pooler URI (port 5432, aws-0-<region>.pooler.supabase.com) —
# not the REST URL, not the IPv6-only db.<ref>.supabase.co host. Percent-encode
# special chars in the password. All bot tables live in the `discord_bot`
# schema (migration 0008); no manual schema setup needed.
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-your-region.pooler.supabase.com:5432/postgres

# Optional
LOG_LEVEL=INFO
SQUAD_ARCHIVE_DAYS=30

# --- MANAVA Gateway integration (real contract) ---
# Gateway mode turns on only when BOTH of the next two are set. Until then the
# bot uses the manual admin overrides (/admin set-verified, /admin
# link-manava-account) and the legacy webhook auth below.
MANAVA_GATEWAY_BASE_URL=

# x-api-key sent on bot -> Gateway calls (identity lookup, webhook management).
DISCORD_BACKEND_API_KEY=

# HMAC-SHA256 key used to verify the x-manava-signature header on inbound
# Gateway -> bot event webhooks. If set, it supersedes MANAVA_WEBHOOK_SECRET.
WEBHOOK_SIGNING_SECRET=

# Public URL of MANAVA's account/connections page. Members who fail the squad
# gate for not being linked/verified are pointed here. Linking happens in the
# MANAVA web app, not the bot. Optional — messages fall back to generic wording.
MANAVA_LINK_URL=

# DEPRECATED legacy webhook auth (shared-secret bearer token). Only used if
# WEBHOOK_SIGNING_SECRET is unset. The webhook server starts if EITHER this or
# WEBHOOK_SIGNING_SECRET is set; the /xpconfig simulate-manava-event harness
# works regardless.
MANAVA_WEBHOOK_SECRET=

# Webhook/health server port. Most hosts inject this; default 8080.
PORT=8080

# REST-polling fallback (only used if bot_config's manava_integration_mode is "polling").
# Not used with the Gateway contract (Gateway pushes webhooks) — kept as a fallback transport.
MANAVA_POLL_URL=
MANAVA_POLL_API_KEY=
MANAVA_POLL_INTERVAL_SECONDS=300
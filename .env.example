# Discord
DISCORD_BOT_TOKEN=your-bot-token-here
DISCORD_GUILD_ID=123456789012345678

# Database (Supabase Postgres connection string — direct connection, not the REST/postgrest URL).
# Use the SESSION POOLER URI from Supabase dashboard -> Project Settings -> Database
# -> Connection pooling, not the direct db.<ref>.supabase.co host: that host is
# IPv6-only and unreachable from many networks/hosts. Session pooler (not
# transaction pooler) because this bot keeps a long-lived connection pool.
# If your password contains special characters (@, :, /, etc.), percent-encode them.
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-your-region.pooler.supabase.com:5432/postgres

# Optional
LOG_LEVEL=INFO
SQUAD_ARCHIVE_DAYS=30

# MANAVA webhook integration (STUB auth until MANAVA provides their real contract).
# If MANAVA_WEBHOOK_SECRET is unset, the webhook server simply doesn't start —
# the /admin simulate-manava-event test harness works regardless.
MANAVA_WEBHOOK_SECRET=change-me-to-a-long-random-value
# Railway sets PORT automatically; only needed locally if you want a non-default port.
PORT=8080

# REST-polling fallback (only used if bot_config's manava_integration_mode is "polling").
# No real MANAVA endpoint exists yet — these are placeholders.
MANAVA_POLL_URL=
MANAVA_POLL_API_KEY=
MANAVA_POLL_INTERVAL_SECONDS=300

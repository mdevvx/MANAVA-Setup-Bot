# Discord
DISCORD_BOT_TOKEN=your-bot-token-here
DISCORD_GUILD_ID=123456789012345678

# Database (Supabase Postgres connection string — direct connection, not the REST/postgrest URL).
# Use the SESSION POOLER URI from Supabase dashboard -> Project Settings -> Database
# -> Connection pooling, not the direct db.<ref>.supabase.co host: that host is
# IPv6-only and unreachable from many networks/hosts. Session pooler (not
# transaction pooler) because this bot keeps a long-lived connection pool.
# If your password contains special characters (@, :, /, etc.), percent-encode them.
DATABASE_URL=postgresql://postgres.your-project-ref:password@aws-0-your-region.pooler.supabase.com:5432/postgres

# Optional
LOG_LEVEL=INFO
SQUAD_ARCHIVE_DAYS=30

# --- MANAVA Gateway integration (real contract) ---
# Gateway mode turns on only when BOTH MANAVA_GATEWAY_BASE_URL and
# DISCORD_BACKEND_API_KEY are set. Until then the bot uses the manual admin
# overrides (/admin set-verified, /admin link-manava-account) and the legacy
# webhook auth below.
#   demo: https://discord-server-backend-gateway-demo.manava.io
#   prod: https://discord-server-backend-gateway.manava.io
MANAVA_GATEWAY_BASE_URL=https://discord-server-backend-gateway-demo.manava.io
# x-api-key sent on the bot -> Gateway identity lookup. This key opens ONLY the
# identity endpoint; MANAVA registers this bot's /webhooks/manava URL themselves.
DISCORD_BACKEND_API_KEY=
# HMAC-SHA256 key used to verify the x-manava-signature header on inbound
# Gateway -> bot event webhooks. If set, it supersedes MANAVA_WEBHOOK_SECRET.
WEBHOOK_SIGNING_SECRET=

# DEPRECATED legacy webhook auth (shared-secret bearer token). Only used if
# WEBHOOK_SIGNING_SECRET is unset. The webhook server starts if EITHER this or
# WEBHOOK_SIGNING_SECRET is set; the /xpconfig simulate-manava-event harness
# works regardless.
MANAVA_WEBHOOK_SECRET=
# Railway sets PORT automatically; only needed locally if you want a non-default port.
PORT=8080

# REST-polling fallback (only used if bot_config's manava_integration_mode is "polling").
# Not used with the Gateway contract (Gateway pushes webhooks) — kept as a fallback transport.
MANAVA_POLL_URL=
MANAVA_POLL_API_KEY=
MANAVA_POLL_INTERVAL_SECONDS=300
